
# ============================================================
# FixFlow AI - Git Ignore Configuration
# ============================================================

# Credentials and local configuration
.env
.env.*
!.env.example
!.env.sample
.streamlit/secrets.toml
*.pem
*.key

# Python environments, caches, and tooling
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local databases and runtime data
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
/docker_data/
**/private_evidence/
local_mailbox.txt
*.log
logs/
tmp/
temp/

# Generated retrieval indexes and backups
local_index/
local_customer_index/
local_index_backup*/
local_customer_index_backup*/
rag_backup/
faiss_index/
chroma/
chromadb/
*.faiss

# Browser and E2E test outputs
playwright-report/
test-results/

# Local diagnostics and generated evaluation outputs
dependencies_before_repair.txt
phase10_acceptance_report.json
phase8d_refund_inventory.txt
phase8d_test_inventory.txt
release_audit/*.txt
eval/five_issue_offline_report.json
eval/phase8c_live*.json
eval/phase8c_part2_audit.json
pytest_collection.txt

# Historical development backups
backend/db/store_phase8d_backup.py
backend/main_phase8d_backup.py
backend/main.py.phase8e.bak
frontend/assests/

# Local runtime reports
/reports/

# ============================================================
# Public Buildathon Evaluation Evidence
# ============================================================

# Allow evidence directory and its public subdirectories
!evidence/
!evidence/logs/
!evidence/test-results/
!evidence/screenshots/

# Allow evidence documentation and captured results
!evidence/README.md
!evidence/logs/*.txt
!evidence/test-results/*.txt
!evidence/screenshots/*.png
!evidence/screenshots/*.jpg
!evidence/screenshots/*.jpeg

# Private evidence remains excluded by the global rule above
