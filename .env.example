# FixFlow AI — example environment configuration
# Copy to .env and replace placeholders with your own values.

OPENAI_API_KEY=your_openai_api_key_here

# Optional: restricted public web search


SEARCH_PROVIDER=serper
SERPER_API_KEY=

FIXFLOW_SMTP_USER=youraccount@gmail.com
FIXFLOW_SMTP_APP_PASSWORD=your-google-app-password
FIXFLOW_MAIL_FROM=youraccount@gmail.com
FIXFLOW_API_URL=http://127.0.0.1:8000