# FixFlow AI — example environment configuration
# Copy to .env and replace placeholders with your own values.
# Never commit .env (it is listed in .gitignore).

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=your-key-here

# --- Backend URL used by the Streamlit frontend -----------------------------
# Local: http://127.0.0.1:8000    Docker Compose: http://api:8000 (set in compose)
FIXFLOW_API_URL=http://127.0.0.1:8000

# --- Storage and retrieval (defaults shown) --------------------------------
# Local SQLite database file (Docker uses /app/data/fixflow.sqlite3)
FIXFLOW_DB=fixflow_local.sqlite3
# Customer-facing retrieval uses only the approved customer index
FIXFLOW_CUSTOMER_INDEX_MODE=approved_only

# --- Local demo only (never enable on a public deployment) -----------------
FIXFLOW_LOCAL_DEMO=0

# --- Email verification and password reset (Gmail SMTP app password) -------
FIXFLOW_SMTP_USER=youraccount@gmail.com
FIXFLOW_SMTP_APP_PASSWORD=your-google-app-password
FIXFLOW_MAIL_FROM=youraccount@gmail.com

# --- Optional: restricted public web search (never authoritative policy) ---
SEARCH_PROVIDER=serper
SERPER_API_KEY=
